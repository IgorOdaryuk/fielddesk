<% content_for :title, "Company settings" %>
<%= render "shared/page_header", title: "Company settings" %>

<div class="grid gap-6 lg:grid-cols-3">
  <%= form_with model: @account, url: account_path, method: :patch, class: "card card-body space-y-5 lg:col-span-2" do |f| %>
    <%= render "shared/errors", record: @account %>
    <div><%= f.label :name, "Company name", class: "label" %><%= f.text_field :name, required: true, class: "input" %></div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :phone, class: "label" %><%= f.telephone_field :phone, value: PhoneNumber.format(@account.phone), class: "input" %></div>
      <div><%= f.label :email, "Billing email", class: "label" %><%= f.email_field :email, class: "input" %></div>
    </div>
    <div><%= f.label :address, class: "label" %><%= f.text_field :address, class: "input" %></div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :tax_rate_percent, "Sales tax on parts, %", class: "label" %><%= f.number_field :tax_rate_percent, step: 0.01, min: 0, max: 20, class: "input" %></div>
      <div><%= f.label :payment_terms_days, "Invoice due in, days", class: "label" %><%= f.number_field :payment_terms_days, min: 0, max: 90, class: "input" %></div>
    </div>
    <div><%= f.label :review_url, "Review link sent after a job", class: "label" %><%= f.url_field :review_url, placeholder: "https://g.page/r/…/review", class: "input" %></div>
    <label class="flex items-center gap-2 text-sm"><%= f.check_box :booking_enabled %> Customers can book online</label>
    <%= f.submit "Save settings", class: "btn-primary" %>
  <% end %>

  <section class="card card-body text-sm space-y-3">
    <h2 class="font-semibold text-base">Online booking</h2>
    <% if @account.booking_enabled? %>
      <p class="text-slate-600">Put this link on your website, Google Business Profile and ads:</p>
      <div class="break-all rounded-lg bg-slate-50 px-3 py-2 font-mono text-xs"><%= book_url(@account.slug) %></div>
      <%= link_to "Open booking page", book_path(@account.slug), target: "_blank", class: "btn-secondary" %>
    <% else %>
      <p class="text-slate-500">Online booking is off.</p>
    <% end %>
  </section>
</div>

<ol class="space-y-3 text-sm">
  <% logs.each do |log| %>
    <li class="border-l-2 border-slate-200 pl-3">
      <div class="text-xs text-slate-500"><%= l(log.created_at, format: "%b %-d, %-l:%M %P") %> · <%= log.user&.name || "System" %></div>
      <div class="font-medium"><%= log.action.tr("._", "  ").capitalize %></div>
      <% log.audited_changes.except("id").first(4).each do |field, (from, to)| %>
        <div class="text-xs text-slate-500"><%= field.humanize %>: <span class="line-through"><%= from.presence || "—" %></span> → <%= to.presence || "—" %></div>
      <% end %>
    </li>
  <% end %>
  <% if logs.empty? %><li class="text-slate-500">No history yet.</li><% end %>
</ol>

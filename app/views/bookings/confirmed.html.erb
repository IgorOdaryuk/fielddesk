<% content_for :title, "You're booked" %>
<div class="card card-body text-center">
  <div class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-emerald-50 text-2xl text-emerald-600">✓</div>
  <h1 class="text-2xl font-semibold">You're booked!</h1>
  <% if @job %>
    <p class="mt-3 text-slate-700"><%= @job.scheduled_at.strftime("%A, %B %-d") %><br><span class="text-lg font-semibold"><%= @job.scheduled_at.strftime("%-l:%M %P") %> – <%= @job.scheduled_end.strftime("%-l:%M %P") %></span></p>
    <p class="mt-3 text-sm text-slate-500"><%= [ @job.brand, @job.appliance ].compact_blank.join(" ") %> repair · <%= @job.property.city %> · confirmation <%= @job.number %></p>
    <p class="mt-4 text-sm text-slate-600"><%= @job.technician.first_name %> will be your technician. We'll text you when they're on the way.</p>
  <% else %>
    <p class="mt-3 text-slate-600">Thanks! We'll text you to confirm.</p>
  <% end %>
  <%= link_to "Book another repair", book_path(@account.slug), class: "btn-secondary mt-6" %>
</div>

<% content_for :title, "Book a repair" %>
<h1 class="text-2xl font-semibold text-center">Book an appliance repair</h1>
<p class="mt-1 mb-6 text-center text-sm text-slate-500">Pick a two-hour arrival window. We'll text you to confirm and when your technician is on the way.</p>

<%= form_with model: @booking, url: book_path(@account.slug), scope: :booking, class: "space-y-5" do |f| %>
  <%= render "shared/errors", record: @booking %>

  <section class="card card-body">
    <h2 class="font-semibold mb-3">1. When should we come?</h2>
    <% if @days.empty? %>
      <p class="text-sm text-slate-500">No windows left this week. Please call <%= PhoneNumber.format(Company.phone) %>.</p>
    <% end %>
    <div class="space-y-4">
      <% @days.each do |date, slots| %>
        <div>
          <div class="mb-2 text-sm font-medium"><%= date == Date.current ? "Today" : (date == Date.tomorrow ? "Tomorrow" : l(date, format: "%A")) %> <span class="text-slate-500 font-normal"><%= l(date, format: "%b %-d") %></span></div>
          <div class="grid grid-cols-3 gap-2 sm:grid-cols-5">
            <% slots.each do |slot| %>
              <label class="<%= slot.available? ? 'cursor-pointer has-[:checked]:bg-brand-600 has-[:checked]:text-white has-[:checked]:ring-brand-600 hover:ring-brand-600' : 'cursor-not-allowed opacity-40 line-through' %> rounded-lg px-2 py-2 text-center text-sm ring-1 ring-slate-300">
                <%= f.radio_button :slot, slot.key, disabled: !slot.available?, class: "sr-only", required: true %>
                <%= slot.label %>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="card card-body space-y-4">
    <h2 class="font-semibold">2. What needs fixing?</h2>
    <div class="grid grid-cols-2 gap-3">
      <div><%= f.label :appliance, class: "label" %><%= f.select :appliance, Job::APPLIANCES, { include_blank: "Choose…" }, required: true, class: "input" %></div>
      <div><%= f.label :brand, class: "label" %><%= f.text_field :brand, placeholder: "e.g. Samsung", class: "input" %></div>
    </div>
    <div><%= f.label :problem, "What's going on?", class: "label" %><%= f.text_area :problem, rows: 3, required: true, placeholder: "e.g. Fridge stopped cooling, freezer still works", class: "input" %></div>
  </section>

  <section class="card card-body space-y-4">
    <h2 class="font-semibold">3. Where and who?</h2>
    <div class="grid grid-cols-2 gap-3">
      <div class="col-span-2 sm:col-span-1"><%= f.label :name, "Your name", class: "label" %><%= f.text_field :name, required: true, autocomplete: "name", class: "input" %></div>
      <div class="col-span-2 sm:col-span-1"><%= f.label :phone, "Mobile phone", class: "label" %><%= f.telephone_field :phone, required: true, autocomplete: "tel", placeholder: "(813) 555-0123", class: "input" %></div>
      <div class="col-span-2"><%= f.label :email, "Email (optional)", class: "label" %><%= f.email_field :email, autocomplete: "email", class: "input" %></div>
      <div class="col-span-2"><%= f.label :street, "Street address", class: "label" %><%= f.text_field :street, required: true, autocomplete: "address-line1", class: "input" %></div>
      <div><%= f.label :unit, "Apt / unit", class: "label" %><%= f.text_field :unit, autocomplete: "address-line2", class: "input" %></div>
      <div><%= f.label :city, class: "label" %><%= f.text_field :city, required: true, autocomplete: "address-level2", class: "input" %></div>
      <div><%= f.label :state, class: "label" %><%= f.text_field :state, required: true, maxlength: 2, autocomplete: "address-level1", class: "input uppercase" %></div>
      <div><%= f.label :zip, "ZIP", class: "label" %><%= f.text_field :zip, required: true, inputmode: "numeric", maxlength: 5, autocomplete: "postal-code", class: "input" %></div>
    </div>
    <div class="hidden" aria-hidden="true"><%= f.text_field :website, tabindex: -1, autocomplete: "off" %></div>
  </section>

  <%= f.submit "Book my repair", class: "btn-primary btn-lg w-full", data: { turbo_submits_with: "Booking…" } %>
  <p class="text-center text-xs text-slate-500">By booking you agree to receive texts about this appointment.</p>
<% end %>

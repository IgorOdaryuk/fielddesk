<%= form_with model: customer, class: "card card-body space-y-5 max-w-2xl" do |f| %>
  <%= render "shared/errors", record: customer %>
  <div>
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, required: true, autofocus: true, class: "input" %>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :phone, class: "label" %>
      <%= f.telephone_field :phone, value: PhoneNumber.format(customer.phone), placeholder: "(813) 555-0100", class: "input" %>
    </div>
    <div>
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, class: "input" %>
    </div>
  </div>
  <div>
    <%= f.label :source, "How did they find us?", class: "label" %>
    <%= f.select :source, Customer::SOURCES.map { [ source_label(_1), _1 ] }, { include_blank: "Unknown" }, class: "input" %>
  </div>

  <% if customer.new_record? %>
    <fieldset class="space-y-4 border-t border-slate-200 pt-5">
      <legend class="text-sm font-semibold mb-2">Service address</legend>
      <%= f.fields_for :properties do |pf| %>
        <%= render "properties/fields", f: pf %>
      <% end %>
    </fieldset>
  <% end %>

  <div>
    <%= f.label :notes, class: "label" %>
    <%= f.text_area :notes, rows: 3, class: "input" %>
  </div>
  <div class="flex gap-2">
    <%= f.submit class: "btn-primary" %>
    <%= link_to "Cancel", customer.persisted? ? customer : customers_path, class: "btn-secondary" %>
  </div>
<% end %>

<div class="text-sm">
  <div class="mb-2 text-slate-500"><%= invoice.number %><%= " · due #{l(invoice.due_on, format: '%b %-d')}" if invoice.due_on && invoice.payable? %></div>

  <table class="w-full">
    <tbody class="divide-y divide-slate-100">
      <% invoice.items.each do |item| %>
        <tr>
          <td class="py-2 pr-2"><%= item.description %><div class="text-xs text-slate-500"><%= item.kind.humanize %><%= " · taxed" if item.taxable? %> · <%= item.quantity.to_s("F").sub(/\.0\z/, "") %> × <%= money(item.unit_price_cents) %></div></td>
          <td class="py-2 text-right tabular-nums whitespace-nowrap"><%= money(item.line_total_cents) %></td>
          <td class="py-2 pl-2 w-6 text-right">
            <% if policy(invoice).update? %>
              <%= button_to "×", invoice_item_path(invoice, item), method: :delete, class: "text-slate-400 hover:text-red-600 cursor-pointer", title: "Remove line" %>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if invoice.items.empty? %><tr><td class="py-3 text-slate-500" colspan="3">No lines yet.</td></tr><% end %>
    </tbody>
  </table>

  <dl class="mt-3 space-y-1 border-t border-slate-200 pt-3 tabular-nums">
    <div class="flex justify-between"><dt class="text-slate-500">Subtotal</dt><dd><%= money(invoice.subtotal_cents) %></dd></div>
    <div class="flex justify-between"><dt class="text-slate-500">Tax <%= number_to_percentage(invoice.tax_rate_bps / 100.0, strip_insignificant_zeros: true) %> on parts</dt><dd><%= money(invoice.tax_cents) %></dd></div>
    <div class="flex justify-between font-semibold"><dt>Total</dt><dd><%= money(invoice.total_cents) %></dd></div>
    <% if invoice.paid_cents.positive? %>
      <div class="flex justify-between text-emerald-700"><dt>Paid</dt><dd>−<%= money(invoice.paid_cents) %></dd></div>
      <div class="flex justify-between font-semibold"><dt>Balance</dt><dd><%= money(invoice.balance_cents) %></dd></div>
    <% end %>
  </dl>

  <% if policy(invoice).update? %>
    <%= form_with model: InvoiceItem.new(kind: :labor, quantity: 1), url: invoice_items_path(invoice), class: "mt-4 grid grid-cols-6 gap-2 rounded-lg bg-slate-50 p-3" do |f| %>
      <%= f.select :kind, InvoiceItem.kinds.keys.map { [ _1.humanize, _1 ] }, {}, class: "input col-span-2" %>
      <%= f.text_field :description, required: true, placeholder: "e.g. Drain pump", class: "input col-span-4" %>
      <%= f.number_field :quantity, step: 0.25, min: 0.25, class: "input col-span-2", "aria-label": "Quantity" %>
      <%= f.text_field :unit_price, required: true, inputmode: "decimal", placeholder: "Price, $", class: "input col-span-2" %>
      <%= f.submit "Add", class: "btn-secondary col-span-2" %>
    <% end %>
  <% end %>

  <div class="mt-4 flex flex-wrap gap-2">
    <% if policy(invoice).send_invoice? %>
      <%= button_to invoice.sent? ? "Resend text" : "Text invoice to customer", send_invoice_invoice_path(invoice), class: invoice.draft? ? "btn-primary" : "btn-secondary" %>
    <% end %>
    <%= link_to "PDF", invoice_path(invoice, format: :pdf), target: "_blank", class: "btn-secondary" %>
    <% if invoice.sent? || invoice.paid? %>
      <%= link_to "Customer page", pay_path(invoice.payment_token), target: "_blank", class: "btn-secondary" %>
    <% end %>
  </div>

  <% if policy(invoice).record_payment? %>
    <details class="mt-4">
      <summary class="cursor-pointer font-medium text-brand-600">Record a payment taken on site</summary>
      <%= form_with model: Payment.new, url: invoice_payments_path(invoice), class: "mt-3 grid grid-cols-6 gap-2" do |f| %>
        <%= f.text_field :amount, value: format("%.2f", invoice.balance_cents / 100.0), inputmode: "decimal", class: "input col-span-2", "aria-label": "Amount" %>
        <%= f.select :method, [ [ "Cash", "cash" ], [ "Check", "check" ], [ "Card on site", "card_on_site" ] ], {}, class: "input col-span-2" %>
        <%= f.text_field :reference, placeholder: "Check #", class: "input col-span-2" %>
        <%= f.submit "Record payment", class: "btn-primary col-span-6 sm:col-span-2" %>
      <% end %>
    </details>
  <% end %>

  <% if invoice.payments.any? %>
    <div class="mt-4 border-t border-slate-200 pt-3">
      <div class="text-xs font-medium uppercase tracking-wide text-slate-500 mb-1">Payments</div>
      <% invoice.payments.each do |payment| %>
        <div class="flex justify-between"><span><%= l(payment.received_at, format: "%b %-d") %> · <%= payment.method.humanize %><%= " ##{payment.reference}" if payment.reference.present? %></span><span class="tabular-nums"><%= money(payment.amount_cents) %></span></div>
      <% end %>
    </div>
  <% end %>
</div>

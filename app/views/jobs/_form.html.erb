<%= form_with model: job, class: "card card-body space-y-5 max-w-3xl" do |f| %>
  <%= render "shared/errors", record: job %>
  <%= f.hidden_field :customer_id %>

  <div class="rounded-lg bg-slate-50 px-4 py-3 text-sm">
    <span class="text-slate-500">Customer</span>
    <div class="font-medium"><%= job.customer.name %> · <%= PhoneNumber.format(job.customer.phone) %></div>
  </div>

  <div>
    <%= f.label :property_id, "Service address", class: "label" %>
    <%= f.collection_select :property_id, job.customer.properties, :id, :one_line, {}, class: "input" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <div><%= f.label :appliance, class: "label" %><%= f.select :appliance, Job::APPLIANCES, { include_blank: true }, required: true, class: "input" %></div>
    <div><%= f.label :brand, class: "label" %><%= f.text_field :brand, placeholder: "Whirlpool", class: "input" %></div>
    <div><%= f.label :model_number, "Model #", class: "label" %><%= f.text_field :model_number, class: "input" %></div>
  </div>

  <div>
    <%= f.label :problem, "What's wrong?", class: "label" %>
    <%= f.text_area :problem, rows: 3, required: true, class: "input" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <div class="sm:col-span-2"><%= f.label :scheduled_at, "Arrival window starts", class: "label" %><%= f.datetime_field :scheduled_at, class: "input" %></div>
    <div><%= f.label :duration_minutes, "Length", class: "label" %><%= f.select :duration_minutes, [ [ "1 hour", 60 ], [ "2 hours", 120 ], [ "3 hours", 180 ], [ "4 hours", 240 ] ], {}, class: "input" %></div>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <div><%= f.label :technician_id, class: "label" %><%= f.collection_select :technician_id, User.technicians, :id, :name, { include_blank: "Unassigned" }, class: "input" %></div>
    <div><%= f.label :priority, class: "label" %><%= f.select :priority, Job.priorities.keys.map { [ _1.humanize, _1 ] }, {}, class: "input" %></div>
    <div><%= f.label :source, class: "label" %><%= f.select :source, Customer::SOURCES.map { [ source_label(_1), _1 ] }, { include_blank: "Unknown" }, class: "input" %></div>
  </div>

  <p class="text-xs text-slate-500">A job with a time and a technician is booked as scheduled right away.</p>

  <div class="flex gap-2">
    <%= f.submit job.new_record? ? "Create job" : "Save job", class: "btn-primary" %>
    <%= link_to "Cancel", job.persisted? ? job : jobs_path, class: "btn-secondary" %>
  </div>
<% end %>

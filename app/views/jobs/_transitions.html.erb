<% targets = job.allowed_transitions_for(current_user) %>
<% if targets.any? %>
  <div class="flex flex-wrap gap-2">
    <% (targets - [ "canceled" ]).each do |target| %>
      <%= button_to transition_label(target), transition_job_path(job, status: target), method: :patch,
            class: target.in?(%w[en_route in_progress completed scheduled]) ? "btn-primary #{local_assigns[:size]}" : "btn-secondary #{local_assigns[:size]}" %>
    <% end %>
  </div>
  <% if targets.include?("canceled") %>
    <details class="mt-3 text-sm">
      <summary class="cursor-pointer text-red-600">Cancel this job</summary>
      <%= form_with url: transition_job_path(job), method: :patch, class: "mt-2 flex gap-2" do |f| %>
        <%= f.hidden_field :status, value: "canceled" %>
        <%= f.text_field :cancel_reason, required: true, placeholder: "Reason, e.g. customer fixed it", class: "input" %>
        <%= f.submit "Cancel job", class: "btn-danger" %>
      <% end %>
    </details>
  <% end %>
<% end %>

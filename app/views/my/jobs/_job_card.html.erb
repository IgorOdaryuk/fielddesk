<%= link_to my_job_path(job), class: "card block p-4 hover:ring-brand-600" do %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="text-sm text-slate-500"><%= job.scheduled_at ? job.scheduled_at.strftime(local_assigns[:with_day] ? "%a %b %-d · %-l:%M %P" : "%-l:%M %P") : "Not scheduled" %></div>
      <div class="font-semibold truncate"><%= job.customer.name %></div>
      <div class="text-sm text-slate-600"><%= [ job.brand, job.appliance ].compact_blank.join(" ") %> · <%= job.property.city %></div>
    </div>
    <div class="flex flex-col items-end gap-1"><%= status_badge(job.status) %><%= priority_badge(job) %></div>
  </div>
<% end %>

<% content_for :title, "SMS outbox" %>
<%= render "shared/page_header", title: "SMS outbox", subtitle: Demo.enabled? ? "Demo mode: these texts were generated by real app events but never left the app." : "Every text sent to customers." %>

<div class="mb-4 flex flex-wrap gap-2 text-sm">
  <% [ [ "All", nil ], [ "Bookings", "booking_confirmation" ], [ "On my way", "on_my_way" ], [ "Review requests", "review_request" ], [ "Invoices", "invoice" ], [ "Receipts", "receipt" ] ].each do |label, value| %>
    <%= link_to label, outbound_messages_path(kind: value), class: params[:kind] == value ? "btn-primary" : "btn-secondary" %>
  <% end %>
</div>

<div class="space-y-3 max-w-3xl">
  <% @messages.each do |message| %>
    <div class="card card-body">
      <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
        <div>
          <span class="font-medium"><%= message.customer&.name || "Unknown" %></span>
          <span class="text-slate-500">· <%= PhoneNumber.format(message.to) %> · <%= message.kind.humanize %></span>
          <% if message.job %><%= link_to message.job.number, message.job, class: "text-brand-600 hover:underline" %><% end %>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-500">
          <%= message.scheduled? ? "Sends #{l(message.send_at, format: '%b %-d, %-l:%M %P')}" : l(message.sent_at || message.send_at, format: "%b %-d, %-l:%M %P") %>
          <%= message_badge(message) %>
        </div>
      </div>
      <div class="mt-2 max-w-md rounded-2xl rounded-tl-sm bg-slate-100 px-4 py-2.5 text-sm"><%= message.body %></div>
      <% if message.error.present? %><div class="mt-1 text-xs text-red-600"><%= message.error %></div><% end %>
    </div>
  <% end %>
  <% if @messages.empty? %><p class="card card-body text-center text-sm text-slate-500">No messages yet. Mark a job "On my way" to see one.</p><% end %>
</div>
<div class="mt-4"><%= page_nav(@pagy) %></div>

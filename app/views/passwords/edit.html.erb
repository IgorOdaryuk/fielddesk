<h1 class="text-lg font-semibold mb-5">Choose a new password</h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :password, "New password", class: "label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 10, maxlength: 72, class: "input" %>
    <p class="mt-1 text-xs text-slate-500">At least 10 characters.</p>
  </div>
  <div>
    <%= form.label :password_confirmation, "Repeat password", class: "label" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
  </div>
  <%= form.submit "Save password", class: "btn-primary w-full" %>
<% end %>

<h1 class="text-lg font-semibold mb-2">Forgot your password?</h1>
<p class="text-sm text-slate-500 mb-5">We'll email you a reset link that works for 15 minutes.</p>

<%= form_with url: passwords_path, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
  </div>
  <%= form.submit "Email reset instructions", class: "btn-primary w-full" %>
  <p class="text-center text-sm"><%= link_to "Back to sign in", new_session_path, class: "text-slate-500 hover:text-slate-700" %></p>
<% end %>

<% content_for :title, "Pay #{@invoice.number}" %>
<div class="card card-body">
  <div class="text-sm text-slate-500">Paying invoice <%= @invoice.number %></div>
  <div class="text-3xl font-semibold tabular-nums mt-1 mb-5"><%= money(@invoice.balance_cents) %></div>

  <div class="mb-5 rounded-lg bg-violet-50 p-3 text-sm text-violet-800 ring-1 ring-violet-600/20">
    Simulated checkout, no real card is charged. Use <code class="font-semibold">4242 4242 4242 4242</code> to pay,
    or <code class="font-semibold">4000 0000 0000 0002</code> to see a decline.
  </div>

  <%= form_with url: pay_checkout_path(@invoice.payment_token), class: "space-y-4", data: { turbo: false } do |f| %>
    <div>
      <%= f.label :card_number, "Card number", class: "label" %>
      <%= f.text_field :card_number, value: "4242 4242 4242 4242", inputmode: "numeric", autocomplete: "off", class: "input font-mono" %>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <div><%= f.label :exp, "Expiry", class: "label" %><%= f.text_field :exp, value: "12 / 34", autocomplete: "off", class: "input font-mono" %></div>
      <div><%= f.label :cvc, "CVC", class: "label" %><%= f.text_field :cvc, value: "123", autocomplete: "off", class: "input font-mono" %></div>
    </div>
    <%= f.submit "Pay #{money(@invoice.balance_cents)}", class: "btn-primary btn-lg w-full" %>
  <% end %>
  <%= link_to "Back to invoice", pay_path(@invoice.payment_token), class: "mt-3 block text-center text-sm text-slate-500" %>
</div>

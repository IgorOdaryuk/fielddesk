<% content_for :title, "Invoice #{@invoice.number}" %>
<% if params[:paid] && !@invoice.paid? %>
  <p class="mb-4 rounded-lg bg-blue-50 px-4 py-2.5 text-sm text-blue-700 ring-1 ring-blue-600/20">Payment is processing. This page will show it as paid in a moment.</p>
<% end %>

<div class="card card-body">
  <div class="flex items-start justify-between">
    <div>
      <div class="text-sm text-slate-500">Invoice <%= @invoice.number %></div>
      <div class="text-3xl font-semibold tabular-nums mt-1"><%= money(@invoice.paid? ? @invoice.total_cents : @invoice.balance_cents) %></div>
      <div class="text-sm text-slate-500 mt-1">
        <%= @invoice.paid? ? "Paid #{l(@invoice.paid_at.to_date, format: '%b %-d, %Y')}" : (@invoice.due_on ? "Due #{l(@invoice.due_on, format: '%b %-d, %Y')}" : "Due on receipt") %>
      </div>
    </div>
    <%= invoice_badge(@invoice) %>
  </div>

  <div class="mt-5 text-sm text-slate-600">
    For <%= @invoice.customer.first_name %> · <%= [ @invoice.job.brand, @invoice.job.appliance ].compact_blank.join(" ") %> repair in <%= @invoice.job.property.city %>
  </div>

  <table class="mt-4 w-full text-sm">
    <tbody class="divide-y divide-slate-100">
      <% @invoice.items.each do |item| %>
        <tr><td class="py-2"><%= item.description %></td><td class="py-2 text-right tabular-nums"><%= money(item.line_total_cents) %></td></tr>
      <% end %>
    </tbody>
  </table>
  <dl class="mt-3 space-y-1 border-t border-slate-200 pt-3 text-sm tabular-nums">
    <div class="flex justify-between"><dt class="text-slate-500">Tax</dt><dd><%= money(@invoice.tax_cents) %></dd></div>
    <div class="flex justify-between font-semibold"><dt>Total</dt><dd><%= money(@invoice.total_cents) %></dd></div>
    <% if @invoice.paid_cents.positive? %><div class="flex justify-between text-emerald-700"><dt>Paid</dt><dd>−<%= money(@invoice.paid_cents) %></dd></div><% end %>
  </dl>

  <% if @invoice.payable? %>
    <%= button_to "Pay #{money(@invoice.balance_cents)}", pay_start_path(@invoice.payment_token), class: "btn-primary btn-lg w-full mt-6", data: { turbo: false } %>
  <% elsif @invoice.void? %>
    <p class="mt-6 text-center text-sm text-slate-500">This invoice was canceled. Nothing is owed.</p>
  <% end %>
  <%= link_to "Download PDF", pay_path(@invoice.payment_token, format: :pdf), class: "btn-secondary w-full mt-3", target: "_blank" %>
</div>
<p class="mt-4 text-center text-xs text-slate-500">Questions? Call <%= PhoneNumber.format(Company.phone) %></p>

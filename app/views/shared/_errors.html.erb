<% if record.errors.any? %>
  <div class="mb-5 rounded-lg bg-red-50 p-4 text-sm text-red-700 ring-1 ring-red-600/20">
    <p class="font-medium mb-1"><%= pluralize(record.errors.count, "problem") %> to fix:</p>
    <ul class="list-disc pl-5 space-y-0.5">
      <% record.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  </div>
<% end %>

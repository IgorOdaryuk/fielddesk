<% if notice.present? %>
  <p id="notice" class="mb-4 rounded-lg bg-emerald-50 px-4 py-2.5 text-sm font-medium text-emerald-700 ring-1 ring-emerald-600/20"><%= notice %></p>
<% end %>
<% if alert.present? %>
  <p id="alert" class="mb-4 rounded-lg bg-red-50 px-4 py-2.5 text-sm font-medium text-red-700 ring-1 ring-red-600/20"><%= alert %></p>
<% end %>

<h1 class="text-lg font-semibold mb-1">Create your company</h1>
<p class="text-sm text-slate-500 mb-5">A private sandbox. Nobody else sees your data, and nobody else sees theirs in yours.</p>

<%= form_with model: @signup, url: signup_path, class: "space-y-4" do |f| %>
  <%= render "shared/errors", record: @signup %>
  <div><%= f.label :company_name, class: "label" %><%= f.text_field :company_name, required: true, autofocus: true, placeholder: "Acme Appliance Repair", class: "input" %></div>
  <div><%= f.label :name, "Your name", class: "label" %><%= f.text_field :name, required: true, autocomplete: "name", class: "input" %></div>
  <div><%= f.label :email_address, "Email", class: "label" %><%= f.email_field :email_address, required: true, autocomplete: "username", class: "input" %></div>
  <div><%= f.label :password, class: "label" %><%= f.password_field :password, required: true, minlength: 10, maxlength: 72, autocomplete: "new-password", class: "input" %><p class="mt-1 text-xs text-slate-500">At least 10 characters.</p></div>
  <label class="flex items-start gap-2 text-sm">
    <%= f.check_box :sample_data, class: "mt-0.5" %>
    <span>Fill it with sample data: a team, customers, a month of jobs and invoices</span>
  </label>
  <%= f.submit "Create company", class: "btn-primary w-full", data: { turbo_submits_with: "Setting up your company…" } %>
  <p class="text-center text-sm"><%= link_to "I already have an account", new_session_path, class: "text-slate-500 hover:text-slate-700" %></p>
<% end %>
